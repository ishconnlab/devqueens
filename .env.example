NODE_ENV=production
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/devqueens
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CLIENT_ORIGIN=https://devqueens.ishconnect.rw
APP_URL=https://devqueens.ishconnect.rw
VITE_API_URL=/api
VITE_PROXY_TARGET=http://127.0.0.1:3001

# Optional image storage. Upload endpoints return a clear configuration error until set.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional certificate signature identity.
CERTIFICATE_SIGNER_NAME=IshConnect Programme Director
CERTIFICATE_SIGNER_TITLE=Authorized Signatory, IshConnect

# Required only when running `npm run seed:admin`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
